# Nexus H1 Environment Variables
# Copy this to .env and fill in your credentials

# Google Gemini API Key (free tier available at aistudio.google.com)
GEMINI_API_KEY=

# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Notion Integration (get from notion.so/my-integrations)
NOTION_TOKEN=

# ElevenLabs API Key (for voice)
ELEVENLABS_API_KEY=

# OpenAI API Key (optional, for STT/assistants if needed)
OPENAI_API_KEY=

# Pi5 / Private Cloud SSH (optional)
PI_HOST=192.168.1.100
PI_USER=ubuntu
PI_PASSWORD=your_password_here
# Or use SSH key instead:
# PI_KEY_PATH=secrets/pi_ssh_key
